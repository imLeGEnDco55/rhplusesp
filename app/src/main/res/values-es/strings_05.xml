<string name="slash_help_close">Cerrar</string>
<string name="slash_help_tip">Los comandos sin argumentos se ejecutan al tocarlos; los que tienen argumentos rellenan el campo de entrada para que los completes</string>
<string name="slash_help_params">Parámetros</string>
<string name="slash_help_examples">Ejemplos</string>
<string name="slash_help_example_prefix">Ej.: </string>
<string name="slash_param_sys_name_name">name=</string>
<string name="slash_param_sys_name_desc">Nombre mostrado (predeterminado: System)</string>
<string name="slash_param_sys_name_example">/sys name=Narrador Una noche lluviosa, calles vacías</string>
<string name="slash_param_sys_at_name">at=</string>
<string name="slash_param_sys_at_desc">Posición de inserción: valores no negativos cuentan desde el inicio y negativos desde el final (-1 = antes del último mensaje)</string>
<string name="slash_param_sys_at_example">/sys at=-1 La batalla terminó, todo quedó en silencio</string>
<string name="slash_param_sendas_name_name">name=</string>
<string name="slash_param_sendas_name_desc">Hablar como este personaje (predeterminado: nombre del personaje actual)</string>
<string name="slash_param_sendas_name_example">/sendas name=Ningning Abrió suavemente la ventana</string>
<string name="slash_param_sendas_at_name">at=</string>
<string name="slash_param_sendas_at_desc">Posición de inserción (igual que /sys at)</string>
<string name="slash_param_sendas_at_example">/sendas at=0 Línea inicial</string>
<string name="slash_param_send_name_name">name=</string>
<string name="slash_param_send_name_desc">Nombre mostrado (predeterminado: tu nombre)</string>
<string name="slash_param_send_name_example">/send name=Yo Quiero ir al mercado nocturno</string>
<string name="slash_param_send_at_name">at=</string>
<string name="slash_param_send_at_desc">Posición de inserción (igual que /sys at)</string>
<string name="slash_param_send_at_example">/send at=0 Primera línea</string>
<string name="slash_param_persona_mode_name">mode=</string>
<string name="slash_param_persona_mode_desc">lookup: elegir una persona existente / temp: definir nombre temporal de usuario / all: probar primero persona y después temp (predeterminado)</string>
<string name="slash_param_persona_mode_example">/persona mode=temp Apodo</string>
<string name="slash_param_persona_off_name">off / none</string>
<string name="slash_param_persona_off_desc">Desactivar la persona actual</string>
<string name="slash_param_persona_off_example">/persona off</string>
<string name="slash_param_sysgen_name_name">name=</string>
<string name="slash_param_sysgen_name_desc">Nombre mostrado para la narración (predeterminado: System)</string>
<string name="slash_param_sysgen_name_example">/sysgen name=Narrador Describe el pasillo por la noche</string>
<string name="slash_param_sysgen_at_name">at=</string>
<string name="slash_param_sysgen_at_desc">Posición de inserción (igual que /sys at)</string>
<string name="slash_param_sysgen_at_example">/sysgen at=-1 Describe la mano sujetando la espada</string>
<string name="slash_param_sysgen_trim_name">trim=</string>
<string name="slash_param_sysgen_trim_desc">true recorta el resultado a oraciones completas</string>
<string name="slash_param_sysgen_trim_example">/sysgen trim=true Describe la calle después de la lluvia</string>
<string name="slash_param_char_update_field_name">field=value</string>
<string name="slash_param_char_update_field_desc">Actualiza varios campos a la vez: name/description/personality/scenario/systemPrompt/firstMessage/messageExamples/creatorNotes/postHistoryInstructions/characterVersion/creator/tags; pon entre comillas los valores que contengan espacios</string>
<string name="slash_param_char_update_field_example">/char-update description=nueva descripción name=nuevo nombre</string>
<string name="slash_param_char_update_tags_name">tags=</string>
<string name="slash_param_char_update_tags_desc">Etiquetas separadas por comas</string>
<string name="slash_param_char_update_tags_example">/char-update tags=guerrero,tranquilo</string>
<string name="slash_param_rename_char_name_name">nuevo nombre</string>
<string name="slash_param_rename_char_name_desc">Nombre al que se cambiará</string>
<string name="slash_param_rename_char_name_example">/rename-char Sirvienta</string>
<string name="slash_param_continue_text_name">texto extra</string>
<string name="slash_param_continue_text_desc">Texto adicional que se añade antes de continuar (opcional; vacío = continuar directamente)</string>
<string name="slash_param_continue_text_example">/continue Entonces se giró para mirar por la ventana</string>
<string name="slash_param_impersonate_prompt_name">prompt</string>
<string name="slash_param_impersonate_prompt_desc">Guía para lo que dirá la IA (opcional)</string>
<string name="slash_param_impersonate_prompt_example">/impersonate Cómo responderías a esta provocación</string>
<string name="slash_param_gen_trim_name">trim=</string>
<string name="slash_param_gen_trim_desc">true reemplaza el campo de entrada; false (predeterminado) añade el resultado al final</string>
<string name="slash_param_gen_trim_example">/gen trim=true Escribe un poema</string>
<string name="slash_param_gen_as_name">as=</string>
<string name="slash_param_gen_as_desc">char: genera desde la perspectiva del personaje (combínalo con name=); de forma predeterminada usa la perspectiva del sistema</string>
<string name="slash_param_gen_as_example">/gen as=char name=Ningning Cómo respondería ella</string>
<string name="slash_param_gen_length_name">length=</string>
<string name="slash_param_gen_length_desc">Tokens máximos de generación (reemplaza temporalmente el ajuste del modelo)</string>
<string name="slash_param_gen_length_example">/gen length=200 Escribe una escena de batalla</string>
<string name="slash_param_gen_name_name">name=</string>
<string name="slash_param_gen_name_desc">Selecciona el personaje por nombre cuando as=char</string>
<string name="slash_param_gen_name_example">/gen name=Ningning Qué diría Ningning al ver las estrellas</string>
